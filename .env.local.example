# ---------------------------------------------------------------------------
# TEMPLATE ONLY — this file IS committed to git. Never put real keys here.
#
# Copy it, then fill the copy in:
#
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored, which is where the real values belong.
# All three come from: Supabase Dashboard → Project Settings → API
# Full walkthrough: ADMIN-SETUP.md
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon / public" key. Safe to expose to the browser — Row Level Security
# (see supabase/schema.sql) is what actually restricts access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SECRET — bypasses all Row Level Security.
# Only `npm run seed` reads it. Never add it to Vercel and never prefix it
# with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
